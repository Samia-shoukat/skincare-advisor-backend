# Copy to .env and fill in. Never commit the filled-in file.
#
# The five marked SECRET are the ones Render asks for when the blueprint is
# applied; everything else already has its value in render.yaml.

# --- secrets -----------------------------------------------------------------

# SECRET. Supabase → Project Settings → Database → Connection string → URI.
# Use the pooler host on port 6543. Leave the scheme as postgresql:// -- the app
# swaps in the asyncpg driver itself (app/db/session.py).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# SECRET. Supabase → Project Settings → API → Project URL.
SUPABASE_URL=https://<ref>.supabase.co

# SECRET. Supabase → Project Settings → API → service_role key.
# Full database access, bypassing row-level security. Server-side only: it must
# never appear in the mobile app, in a log, or in a chat window.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET. Supabase → Project Settings → API → JWT Settings → JWT Secret.
# Used to verify the tokens the app sends, so a wrong value rejects every user.
JWT_SECRET=

# SECRET. Google AI Studio → API keys. Billing must be enabled; the free tier
# rate-limits hard enough that scans fail intermittently.
GEMINI_API_KEY=

# --- configuration -----------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO
GEMINI_MODEL=gemini-3.8-flash
CONSENT_STATEMENT_VERSION=1.2
SUPPORT_EMAIL=support@example.com
OPERATOR_NAME=AI Skincare Advisor project team

# FR-SUB-004. Off is for testing only; in production it gives unlimited scans.
QUOTA_ENFORCED=true
DEFAULT_SCAN_ALLOWANCE=1

# CON-005. Asks the analysis provider not to retain submitted images.
PROVIDER_RETENTION_DISABLED=true
