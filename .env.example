DATABASE_URL=postgresql://user:password@localhost:5432/skincare_db
SECRET_KEY=your_secret_key_here
# FR-AI-004. Tasks one scan runs. COMBINED = one provider call (OBJ-002).
ANALYSIS_PLAN=COMBINED
# FR-AI-010. Tasks for the internal model. Empty in release 1.0 (ADR-015).
INTERNAL_MODEL_TASKS=

# DR-002. Server-only key used to delete the Supabase sign-in on account
# deletion. Supabase dashboard -> Project Settings -> API -> service_role.
# NEVER put this in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Shown to users and in the privacy policy. Must be a real, monitored inbox.
SUPPORT_EMAIL=support@example.com
OPERATOR_NAME=AI Skincare Advisor project team

# Pinned; see app/core/config.py.
GEMINI_MODEL=gemini-3.8-flash
